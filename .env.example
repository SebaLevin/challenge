# ==============================================================================
# Companies & Transfers API - Environment Variables (example)
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# All variables have sensible defaults — the app runs without a .env file.
# ==============================================================================

# HTTP server port (default: 3000)
PORT=3000

# Directory where JSON persistence files live (default: ./data)
# Useful for tests (point to a temp dir) or for deployments where data
# lives on a mounted volume.
DATA_DIR=./data

# ------------------------------------------------------------------------------
# AWS Lambda — register-company (NOT used by the local NestJS API)
# ------------------------------------------------------------------------------

# DynamoDB table name for the Lambda function (default: companies)
COMPANIES_TABLE_NAME=companies